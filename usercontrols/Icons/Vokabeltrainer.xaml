             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Quiz_show.usercontrols.Icons"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="40">
    <Canvas>
        <Rectangle Stroke="Transparent" StrokeThickness="0" MouseEnter="Vokabel_rect_MouseEnter" MouseLeave="Vokabel_rect_MouseLeave" MouseUp="Vokabel_rect_MouseUp" x:Name="Vokabel_rect" Height="40" Width="40" Fill="LightGreen" RadiusX="10" RadiusY="10"/>
        <Label MouseEnter="Vokabel_rect_MouseEnter" MouseLeave="Vokabel_rect_MouseLeave" MouseUp="Vokabel_rect_MouseUp" x:Name="Vokabel_label" Content="Vok" Canvas.Left="5" Canvas.Top="7" HorizontalAlignment="Left" VerticalAlignment="Top"/>

    </Canvas>
</UserControl>
