<Page x:Class="Quiz_show.Frames.Homepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:uc="clr-namespace:Quiz_show.usercontrols.Icons"
      xmlns:local="clr-namespace:Quiz_show.Frames"
      mc:Ignorable="d"
      d:DesignHeight="1000"
      d:DesignWidth="1500"
      Title="Homepage"
      Loaded="Page_Loaded">

    <Viewbox>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <uc:Quiz Width="400" Height="200" Grid.Column="0" Grid.Row="0"/>
            <uc:Fortschritt x:Name="Fortschritt_home" Width="400" Height="200" Grid.Column="1" Grid.Row="0"/>
            <uc:Shop x:Name="Shop_home" Width="400" Height="200" Grid.Column="2" Grid.Row="0"/>
            <uc:Achievements x:Name="Achievements_home" Width="400" Height="200" Grid.Column="0" Grid.Row="1"/>
        </Grid>
    </Viewbox>

</Page>