<Page x:Class="Quiz_show.Frames.Register_1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quiz_show.Frames"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="Register_1">

    <Grid>
        <Canvas Height="153" Width="260" HorizontalAlignment="Center" VerticalAlignment="Center" Background="AliceBlue">
            <TextBox x:Name="email_register" FontSize="10" Height="20" Canvas.Left="58" TextWrapping="Wrap" Text="" Canvas.Top="10" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <PasswordBox x:Name="password_register" FontSize="10" Canvas.Left="58" Canvas.Top="41" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" />
            <PasswordBox PasswordChanged="password_again_register_PasswordChanged" x:Name="password_again_register" FontSize="10" Canvas.Left="58" Canvas.Top="66" Width="160" HorizontalAlignment="Center" VerticalAlignment="Top" Height="20" />
            <Label Content="E-Mail" Canvas.Left="10" Canvas.Top="6" HorizontalAlignment="Center" Height="33" VerticalAlignment="Top" Width="43"/>
            <Label Content="Passwort" Canvas.Left="4" Canvas.Top="37"/>
            <Button x:Name="erstellen_register" Content="Erstellen" Canvas.Left="130" Canvas.Top="123" HorizontalAlignment="Center" VerticalAlignment="Top" Height="20" Width="53" Click="erstellen_register_Click"/>
            <Button x:Name="abb_register" Content="Cancel" Canvas.Left="67" Canvas.Top="123" HorizontalAlignment="Left" VerticalAlignment="Top" Click="abb_register_Click"/>
            <Label FontSize="10" Content="Passwort" Canvas.Left="1" Canvas.Top="63" HorizontalAlignment="Center" VerticalAlignment="Top" Height="22" Width="55"/>
            <Label FontSize="10" Content="nochmal" Canvas.Left="4" Canvas.Top="74" Height="21" Width="55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Label x:Name="pass_req" Content="Password is at least 6 Chars long" Canvas.Left="64" Canvas.Top="91" HorizontalAlignment="Left" VerticalAlignment="Center" Width="154" FontSize="10" Foreground="Red"/>

        </Canvas>
    </Grid>
</Page>
