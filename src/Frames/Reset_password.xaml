<Page x:Class="Quiz_show.Frames.Reset_password"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quiz_show.Frames"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="Reset_password">

    <Grid>
        <Canvas Height="126" Width="260" HorizontalAlignment="Center" VerticalAlignment="Center" Background="AliceBlue">
            <PasswordBox x:Name="new_password" FontSize="10" Height="20" Canvas.Left="58" Canvas.Top="10" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" PasswordChanged="new_password_PasswordChanged"/>
            <PasswordBox x:Name="new_password_again" FontSize="10" Canvas.Left="58" Canvas.Top="41" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" PasswordChanged="new_password_again_PasswordChanged"/>
            <Label Content="Password:" Canvas.Left="-2" Canvas.Top="6" HorizontalAlignment="Left" Height="33" VerticalAlignment="Center" Width="61"/>
            <Label Content="Password:" Canvas.Top="37" HorizontalAlignment="Left" VerticalAlignment="Center" Width="66"/>
            <Button x:Name="reset_reset" Content="Reset" Canvas.Left="130" Canvas.Top="96" HorizontalAlignment="Left" VerticalAlignment="Center" Click="reset_reset_Click" Height="20" Width="74"/>
            <Button x:Name="abb_pass_reset" Content="Abb" Canvas.Left="86" Canvas.Top="96" HorizontalAlignment="Left" VerticalAlignment="Center" Click="abb_pass_reset_Click"/>
            <Label x:Name="criterien" Content="Password has at least 6 chars" Canvas.Left="58" Canvas.Top="61" HorizontalAlignment="Left" VerticalAlignment="Center" Width="160" FontSize="10" Foreground="Red"/>

        </Canvas>
    </Grid>
</Page>
