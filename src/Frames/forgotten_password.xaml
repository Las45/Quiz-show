<Page x:Class="Quiz_show.Frames.forgotten_password"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quiz_show.Frames"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="forgotten_password">

    <Grid x:Name="reset_grid">
        <Canvas Height="82" Width="260" HorizontalAlignment="Center" VerticalAlignment="Center" Background="AliceBlue">
            <TextBox x:Name="e_mail_reset" FontSize="10" Height="20" Canvas.Left="66" TextWrapping="Wrap" Text="" Canvas.Top="21" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Label Content="E-Mail:" Canvas.Left="4" Canvas.Top="18" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Button x:Name="reset_reset" Content="Reset" Canvas.Left="146" Canvas.Top="52" HorizontalAlignment="Left" VerticalAlignment="Center" Height="20" Width="52" Click="reset_reset_Click"/>
            <Button x:Name="abb_reset" Content="Abb" Canvas.Left="78" Canvas.Top="52" HorizontalAlignment="Left" VerticalAlignment="Center" Height="20" Width="52" Click="abb_reset_Click"/>
        </Canvas>
    </Grid>
</Page>
