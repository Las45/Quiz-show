<Page x:Class="Quiz_show.Frames.Homepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ucai ="clr-namespace:Quiz_show.src.usercontrols.Icons"
      xmlns:uc="clr-namespace:Quiz_show.usercontrols.Icons"
      xmlns:local="clr-namespace:Quiz_show.Frames"
      mc:Ignorable="d"
      d:DesignHeight="1000"
      d:DesignWidth="1500"
      Title="Homepage"
      Background="White"
      Loaded="Page_Loaded">

    <Viewbox>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <uc:Quiz Width="400" Height="200" Grid.Row="1" Grid.Column="0" Margin="20,20,20,20"/>
            <uc:Fortschritt Width="400" Height="200" Grid.Row="1" Grid.Column="1" Margin="20,20,20,20"/>
            <uc:ShopUseroCntrol Width="400" Height="200" Grid.Row="1" Grid.Column="2" Margin="20,20,20,20"/>
            <uc:Achievements Width="400" Height="200" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="20,20,20,20"/>
            <ucai:Install_AI Grid.Row="2" Grid.Column="1" Margin="20,20,20,20"/>
            <uc:Exit Width="400" Height="200" Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" Margin="20,20,20,20"/>
        </Grid>
    </Viewbox>
</Page>
