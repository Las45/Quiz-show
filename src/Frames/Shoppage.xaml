<Page x:Class="Quiz_show.Frames.Shoppage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quiz_show.Frames"
      mc:Ignorable="d" 
      d:DesignHeight="1000"
      d:DesignWidth="1500"
      Title="Shop" Foreground="#FF5C1003">

    <Grid>
        <Rectangle MouseUp="RectOriginalButton_MouseUp" Name="RectOriginalButton" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="250,200,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>
        <Rectangle MouseUp="RectRotButton_MouseUp"  Name="RectRotButton" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="650,200,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>
        <Rectangle MouseUp="RectGoldButton_MouseUp"  Name="RectGoldButton" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="1050,200,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>


        <Rectangle MouseUp="RectOriginalBackground_MouseUp"  Name="RectOriginalBackground" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="250,550,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>
        <Rectangle MouseUp="RectGrünBackground_MouseUp"  Name="RectGrünBackground" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="650,550,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>
        <Rectangle MouseUp="RectSilberBackground_MouseUp"  Name="RectSilberBackground" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="1050,550,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>


        <Label Content="Shop" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Top" Height="127" Width="200" FontSize="80" Foreground="#FF450000"/>



        <Label MouseUp="RectOriginalButton_MouseUp"  Name="LabelOriginalButton" Content="Original" HorizontalAlignment="Left" Margin="260,262,0,0" VerticalAlignment="Top" Height="76" Width="190" FontSize="48" Foreground="#FF450000"/>
        <Label MouseUp="RectOriginalBackground_MouseUp"  Name="LabelOriginalBackground" Content="Original" HorizontalAlignment="Left" Margin="260,612,0,0" VerticalAlignment="Top" Height="76" Width="190" FontSize="48" Foreground="#FF450000"/>

        <Label MouseUp="RectRotButton_MouseUp"  Name="LabelRotButton" Content="Rot" HorizontalAlignment="Left" Margin="710,262,0,0" VerticalAlignment="Top" Height="76" Width="190" FontSize="48" Foreground="#FF450000"/>
        <Label MouseUp="RectGrünBackground_MouseUp"  Name="LabelGrünBackground" Content="Grün" HorizontalAlignment="Left" Margin="690,612,0,0" VerticalAlignment="Top" Height="76" Width="190" FontSize="48" Foreground="#FF450000"/>


        <Label MouseUp="RectGoldButton_MouseUp"  Name="LabelGoldButton" Content="Gold" HorizontalAlignment="Left" Margin="1090,262,0,0" VerticalAlignment="Top" Height="76" Width="190" FontSize="48" Foreground="#FF450000"/>
        <Label MouseUp="RectSilberBackground_MouseUp" Name="LabelSilberBackground" Content="Silber" HorizontalAlignment="Left" Margin="1090,612,0,0" VerticalAlignment="Top" Height="76" Width="190" FontSize="48" Foreground="#FF450000"/>

        <Label Name="Price1" Content="20 Coins" HorizontalAlignment="Left" Margin="650,392,0,0" VerticalAlignment="Top" Height="76" Width="190" FontSize="48" Foreground="#FF450000"/>
        <Label Name="Price2" Content="30 Coins" HorizontalAlignment="Left" Margin="650,742,0,0" VerticalAlignment="Top" Height="76" Width="190" FontSize="48" Foreground="#FF450000"/>

        <Label Name="Price3" Content="100 Coins" HorizontalAlignment="Left" Margin="1040,392,0,0" VerticalAlignment="Top" Height="76" Width="230" FontSize="48" Foreground="#FF450000"/>
        <Label Name="Price4" Content="100 Coins" HorizontalAlignment="Left" Margin="1040,742,0,0" VerticalAlignment="Top" Height="76" Width="230" FontSize="48" Foreground="#FF450000"/>


        <Label Content="Button Design:" HorizontalAlignment="Left" Margin="580,100,0,0" VerticalAlignment="Top" Height="76" Width="460" FontSize="48" Foreground="#FF450000"/>
        <Label Content="Background Design:" HorizontalAlignment="Left" Margin="530,450,0,0" VerticalAlignment="Top" Height="76" Width="473" FontSize="48" Foreground="#FF450000"/>

        <Path Name="PathExit"
      Width="150"
      Height="100"
      Fill="SkyBlue"
      Stroke="#082430"
      StrokeThickness="4"
      Stretch="Fill"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Margin="79,430,0,0"
      Cursor="Hand"

      MouseEnter="PathExit_MouseEnter"
      MouseLeave="PathExit_MouseLeave"
      MouseUp="PathExit_MouseUp"
       
      Data="M46,8 
            L46,34 
            L76,34 
            L76,8 
            L108,8 
            L108,44 
            C108,62 92,62 76,62 
            L46,62 
            L46,82 
            L8,45 
            L46,8 
            Z"/>
        <Label Name="MoneyLabel" Content="0 Coins" HorizontalAlignment="Left" Margin="1262,62,0,0" VerticalAlignment="Top" Height="76" Width="190" FontSize="48" Foreground="#FF450000"/>


    </Grid>
</Page>
