<Page x:Class="Quiz_show.Frames.Shoppage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quiz_show.Frames"
      mc:Ignorable="d" 
      d:DesignHeight="1000"
      d:DesignWidth="1500"
      Title="Shop" Foreground="#FF5C1003"
      Loaded="Page_Loaded">

    <Viewbox>
        <Grid Width="1500" Height="1000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="300"/>
            </Grid.RowDefinitions>

            <Path Name="PathExit"
                  Width="150" Height="100"
                  Fill="SkyBlue" Stroke="#082430" StrokeThickness="4" Stretch="Fill"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Margin="40,0,0,0" Cursor="Hand"
                  MouseEnter="PathExit_MouseEnter"
                  MouseLeave="PathExit_MouseLeave"
                  MouseUp="PathExit_MouseUp"
                  Data="M46,8 L46,34 L76,34 L76,8 L108,8 L108,44 C108,62 92,62 76,62 L46,62 L46,82 L8,45 L46,8 Z"
                  Grid.Column="0" Grid.Row="0"/>

            <Label Content="Shop" HorizontalAlignment="Center" VerticalAlignment="Center" Height="125" Width="200" FontSize="80" Foreground="#FF450000" Grid.Column="1" Grid.Row="0"/>

            <Label Name="MoneyLabel" Content="0 Coins" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" Height="76" Width="190" FontSize="48" Foreground="#FF450000" Grid.Column="2" Grid.Row="0"/>

            <Label Content="Button Design:" HorizontalAlignment="Center" VerticalAlignment="Center" Height="76" FontSize="48" Foreground="#FF450000" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"/>

            <Rectangle Name="RectOriginalButton" Fill="SkyBlue" Height="200" Stroke="Black" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Grid.Row="2" Margin="0,0,0,60" Cursor="Hand" MouseUp="RectOriginalButton_MouseUp"/>
            <Label Name="LabelOriginalButton" Content="Original" Height="76" Width="190" FontSize="44" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FF450000" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Grid.Row="2" Margin="0,0,0,60" IsHitTestVisible="False"/>

            <Rectangle Name="RectRotButton" Fill="SkyBlue" Height="200" Stroke="Black" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Grid.Row="2" Margin="0,0,0,60" Cursor="Hand" MouseUp="RectRotButton_MouseUp"/>
            <Label Name="LabelRotButton" Content="Rot" Height="76" Width="190" FontSize="44" Foreground="#FF450000" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Grid.Row="2" Margin="0,0,0,60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsHitTestVisible="False"/>
            <Label Name="Price1" Content="20 Coins" Height="75" Width="190" FontSize="36" HorizontalContentAlignment="Center" Foreground="#FF450000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="2" Margin="0,0,0,0" />

            <Rectangle Name="RectGoldButton" Fill="SkyBlue" Height="200" Stroke="Black" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" Grid.Row="2" Margin="0,0,0,60" Cursor="Hand" MouseUp="RectGoldButton_MouseUp"/>
            <Label Name="LabelGoldButton" Content="Gold" Height="76" Width="190" FontSize="44" Foreground="#FF450000" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" Grid.Row="2" Margin="0,0,0,60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsHitTestVisible="False"/>
            <Label Name="Price3" Content="100 Coins" Height="76" FontSize="36" HorizontalContentAlignment="Center" Foreground="#FF450000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="2" Grid.Row="2" Margin="0,0,0,0"/>

            <Label Content="Background Design:" Height="76" FontSize="48" Foreground="#FF450000" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Rectangle Name="RectOriginalBackground" Fill="SkyBlue" Height="200" Stroke="Black" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Grid.Row="4" Margin="0,0,0,60" Cursor="Hand" MouseUp="RectOriginalBackground_MouseUp"/>
            <Label Name="LabelOriginalBackground" Content="Original" Height="76" Width="190" FontSize="44" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#FF450000" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Grid.Row="4" Margin="0,0,0,60" IsHitTestVisible="False"/>

            <Rectangle Name="RectGrünBackground" Fill="SkyBlue" Height="200" Stroke="Black" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Grid.Row="4" Margin="0,0,0,60" Cursor="Hand" MouseUp="RectGrünBackground_MouseUp"/>
            <Label Name="LabelGrünBackground" Content="Grün" Height="76" Width="190" FontSize="44" Foreground="#FF450000" Grid.Column="1" Grid.Row="4" Margin="0,0,0,60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsHitTestVisible="False"/>
            <Label Name="Price2" Content="30 Coins" Height="76" Width="190" FontSize="36" HorizontalContentAlignment="Center" Foreground="#FF450000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="4" Margin="0,0,0,0"/>

            <Rectangle Name="RectSilberBackground" Fill="SkyBlue" Height="200" Stroke="Black" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" Grid.Row="4" Margin="0,0,0,60" Cursor="Hand" MouseUp="RectSilberBackground_MouseUp"/>
            <Label Name="LabelSilberBackground" Content="Silber" Height="76" Width="190" FontSize="44" Foreground="#FF450000" Grid.Column="2" Grid.Row="4" Margin="0,0,0,60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsHitTestVisible="False"/>
            <Label Name="Price4" Content="100 Coins" Height="76" FontSize="36" HorizontalContentAlignment="Center" Foreground="#FF450000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="2" Grid.Row="4" Margin="0,0,0,0"/>

        </Grid>
    </Viewbox>
</Page>
