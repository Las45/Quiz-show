<Page x:Class="Quiz_show.Frames.Register_2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quiz_show.Frames"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="Register_2">

    <Grid>
        <Canvas Height="82" Width="260" HorizontalAlignment="Center" VerticalAlignment="Center" Background="AliceBlue">
            <TextBox x:Name="pin_register" FontSize="10" Height="20" Canvas.Left="66" TextWrapping="Wrap" Text="" Canvas.Top="21" Width="160" HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <Label Content="Sent PIN:" Canvas.Left="4" Canvas.Top="18" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Button x:Name="login_register" Content="Creat" Canvas.Left="104" Canvas.Top="52" HorizontalAlignment="Left" VerticalAlignment="Center" Height="20" Width="52" Click="login_register_Click"/>
        </Canvas>
    </Grid>
</Page>
