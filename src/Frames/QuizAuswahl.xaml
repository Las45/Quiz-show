<Page x:Class="Quiz_show.Frames.QuizAuswahl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quiz_show.Frames"
      mc:Ignorable="d" 
            d:DesignHeight="1000"
      d:DesignWidth="1500"
      Title="Achievements" Foreground="#FF5C1003">

    <Grid>
        <Rectangle MouseEnter="RectQuiz1_MouseEnter" MouseLeave="RectQuiz1_MouseLeave" MouseUp="RectQuiz1_MouseUp" Name="RectQuiz1" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="250,200,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>
        <Rectangle Name="RectQuiz2" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="650,200,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>
        <Rectangle Name="RectQuiz3" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="1050,200,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>


        <Rectangle Name="RectQuiz4" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="450,488,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>
        <Rectangle Name="RectQuiz5" HorizontalAlignment="Left" Fill="SkyBlue" Height="200" Margin="850,488,0,0" Stroke="Black" VerticalAlignment="Top" Width="200"/>


        <Label Content="Quiz:" HorizontalAlignment="Left" VerticalAlignment="Top" Height="127" Width="715" FontSize="80" Foreground="#FF450000" Margin="650,31,0,0"/>



        <Label Name="LabelQuiz1" Content="POS" HorizontalAlignment="Left" Margin="292,262,0,0" VerticalAlignment="Top" Height="76" Width="116" FontSize="48" Foreground="#FF450000"/>
        <Label Name="LabelQuiz2" Content="CABS" HorizontalAlignment="Left" Margin="492,550,0,0" VerticalAlignment="Top" Height="76" Width="176" FontSize="48" Foreground="#FF450000"/>

        <Label Name="LabelQuiz3" Content="NSCS" HorizontalAlignment="Left" Margin="690,262,0,0" VerticalAlignment="Top" Height="76" Width="226" FontSize="48" Foreground="#FF450000"/>
        <Label Name="LabelQuiz4" Content="Geschichte" HorizontalAlignment="Left" Margin="862,563,0,0" VerticalAlignment="Top" Height="76" Width="288" FontSize="36" Foreground="#FF450000"/>


        <Label Name="LabelQuiz5" Content="Englisch" HorizontalAlignment="Left" Margin="1058,262,0,0" VerticalAlignment="Top" Height="76" Width="184" FontSize="48" Foreground="#FF450000"/>

        <Rectangle Name="RectQuizBackground" Height="1000" Width="1500" Fill="White" Visibility="Hidden"/>

        <Grid Name="QuizContainer" Width="800" Height="400" Background="Transparent" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
