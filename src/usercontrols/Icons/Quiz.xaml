             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="400">
    <Canvas>
        <Rectangle Stroke="Transparent" StrokeThickness="0" MouseEnter="Quiz_rect_MouseEnter" MouseLeave="Quiz_rect_MouseLeave" MouseUp="Quiz_rect_MouseUp" x:Name="Quiz_rect" Height="200" Width="400" Fill="LightBlue" RadiusX="10" RadiusY="10"/>
