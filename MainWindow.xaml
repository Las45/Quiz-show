<Window x:Class="Quiz_show.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz_show"
        xmlns:quiz="clr-namespace:Quiz_show.usercontrols"
        mc:Ignorable="d"
        Icon="Images/Powertoys.png"
        Title="Wer wird Milionär?" 
        Height="450" Width="800">
    <Canvas>
        <Button x:Name="Allgemein" Content="Allgemein" Canvas.Left="10" Canvas.Top="86" Height="50" Width="120" Background="White" Click="Allgemein_Click"></Button>
        <Button x:Name="Pos" Content="Programmieren" Canvas.Left="150" Canvas.Top="86" Height="50" Width="120" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button x:Name="Geschichte" Content="Geschichte" Canvas.Left="290" Canvas.Top="86" Height="50" Width="120" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button x:Name="Tranlator" Content="Translator" Canvas.Left="430" Canvas.Top="86" Height="50" Width="120" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OpenTranslator"/>
    </Canvas>
</Window>
